# Supabase (proyecto nuevo — Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Arkham Intelligence — opcional
ARKHAM_API_KEY=tu-arkham-api-key

# Cron secret (protege /api/cron/* en producción)
CRON_SECRET=genera-un-string-aleatorio-aqui

CTECH_BASE_URL=https://tu-app.vercel.app

# Wallet PWA (BNB Smart Chain) — /wallet
NEXT_PUBLIC_WALLET_APP_NAME=Trust Wallet Web
NEXT_PUBLIC_WALLET_CHAIN_ID=56
# NEXT_PUBLIC_BSC_RPC_URL=https://bsc-dataseed.binance.org
# Token personalizado opcional (aparece en lista + precio DexScreener)
# NEXT_PUBLIC_CUSTOM_TOKEN_ADDRESS=0x...
# NEXT_PUBLIC_CUSTOM_TOKEN_SYMBOL=TOKEN
# NEXT_PUBLIC_CUSTOM_TOKEN_NAME=Mi Token
# NEXT_PUBLIC_CUSTOM_TOKEN_DECIMALS=18
