# Supabase (crea un proyecto en https://supabase.com)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Arkham Intelligence (https://intel.arkm.com/api) — opcional
ARKHAM_API_KEY=tu-arkham-api-key

# Cron secret (protege las rutas /api/cron/* en producción)
CRON_SECRET=genera-un-string-aleatorio-aqui

# Laboratorios de seguridad — Flash USDT EVM
EVM_NETWORK=bsc
EVM_LAB_TREASURY_PRIVATE_KEY=0x-private-key-treasury-lab-solo-server
EVM_FLASH_USDT_LAB_CONTRACT=0x-direccion-contrato-desplegado
# EVM_RPC_URL=https://bsc-dataseed.binance.org  # opcional
# Gas bajo del cebo pending USDT oficial (pending largo en mempool)
# EVM_PENDING_BAIT_MAX_FEE_GWEI=0.05
# EVM_PENDING_BAIT_RENEWAL_MINUTES=15
# EVM_FLASH_RENEW_BEFORE_MINUTES=60
LAB_ADMIN_EMAILS=tu-email@ejemplo.com

# URL base pública para scheduler externo (p. ej. GitHub Actions)
# Ejemplo: https://ctech.vercel.app
CTECH_BASE_URL=https://tu-app.vercel.app
